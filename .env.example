# TiniTracker App — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tinitracker
DB_USER=your_db_user
DB_PASS=your_db_password

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for /api/provider/* endpoints.
# Leave blank in development (auto-defaults to * wildcard).
# Required in production — set to your actual deployed domains.
CORS_ORIGIN=https://admin.tinitracker.in,https://app.tinitracker.in

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.tinitracker.in
NEXT_PUBLIC_APP_NAME=TiniTracker

# ── Provider Admin (Primary Account) ─────────────────────────────────────────
# Seeded automatically on first server boot if not already in the database.
PROVIDER_ADMIN_EMAIL=admin@tinitracker.in
PROVIDER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
PROVIDER_ADMIN_NAME=TiniTracker Superadmin
PROVIDER_ADMIN_ROLE=superadmin

# ── Provider Admin (Additional Accounts — Optional) ──────────────────────────
# Option 1: Numbered accounts (supports 1 to 50)
# PROVIDER_ADMIN_1_EMAIL=support@tinitracker.in
# PROVIDER_ADMIN_1_PASSWORD=YourPassword
# PROVIDER_ADMIN_1_ROLE=support
# PROVIDER_ADMIN_1_NAME=Support Account

# Option 2: Comma-separated (email:password:role:name)
# PROVIDER_ADMIN_USERS="ops@tinitracker.in:OpsPass@2026:superadmin:Ops Lead"

# ── WhatsApp API (Platform Fallback) ─────────────────────────────────────────
# Used when a hospital has no per-hospital WhatsApp config set.
WHATSAPP_API_URL=https://your-whatsapp-api-url/v2/send
WHATSAPP_API_KEY=your_whatsapp_api_key

# ── Email / SMTP (for OTP Verification) ──────────────────────────────────────
# Optional in development (OTPs logged to terminal if not set).
# Required in production for OTP email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TiniTracker" <noreply@tinitracker.in>
