# ──────────────────────────────────────────────────────
# TiniTracker-Next  —  Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tinitracker
DB_USER=your_db_user
DB_PASS=your_db_password

# JWT Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# CORS (Provider API)
# Comma-separated list of allowed origins for the /api/provider/* endpoints.
# In development, leave blank (defaults to * wildcard for convenience).
# In PRODUCTION, set this to your actual admin frontend domain(s).
# CORS_ORIGIN=https://admin.tinitracker.in,https://app.tinitracker.in

# WhatsApp API (platform-level fallback)
# Can also be configured per-hospital in the Hospital Settings UI.
WHATSAPP_API_URL=https://your-whatsapp-api-url/v2/send
WHATSAPP_API_KEY=your_whatsapp_api_key

# Next.js Public Env (safe to expose in browser)
NEXT_PUBLIC_APP_NAME=TiniTraker

# ── Provider Admin Credentials ────────────────────────────────────────────────
# Primary provider superadmin (seeded on first run if no admin exists)
PROVIDER_ADMIN_EMAIL=admin@tinitracker.in
PROVIDER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
PROVIDER_ADMIN_NAME=TiniTracker Superadmin
PROVIDER_ADMIN_ROLE=superadmin

# ── Additional Provider Admin Accounts (Optional) ────────────────────────────
# Option 1: Numbered accounts (supports 1 to 50)
# PROVIDER_ADMIN_1_EMAIL=support@tinitracker.in
# PROVIDER_ADMIN_1_PASSWORD=YourPassword
# PROVIDER_ADMIN_1_ROLE=support
# PROVIDER_ADMIN_1_NAME=Support Account

# Option 2: Comma-separated list (email:password[:role][:name])
# PROVIDER_ADMIN_USERS="ops@tinitracker.in:OpsPass@2026:superadmin:Ops Lead"

# ── Email / SMTP Configuration for OTP Verification ──────────────────────────
# Required in production for OTP email delivery.
# Without these, OTP emails will NOT be sent in production.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="TiniTraker" <noreply@tinitraker.in>
