# TiniTraker App — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tinitracker
DB_USER=your_db_user
DB_PASS=your_db_password

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. The server refuses to start otherwise.
#
# IMPORTANT: provider (admin portal) tokens and app-user tokens are signed with
# this SAME secret, but they MUST have distinct `type` claims:
#   - app users   -> type: 'user'
#   - provider    -> type: 'provider'
# The API rejects a token whose type does not match the surface it is used on.
# The admin portal's JWT_SECRET must match this value exactly.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated trusted origins. proxy.js emits exactly ONE allowed Origin per
# request (never a comma-separated ACAO header).
# - Include the admin portal origin (https://admin.tinitraker.in) so provider
#   API calls and admin pass-through requests are allowed.
# - Include the app origin (https://app.tinitraker.in).
# Leave blank in development (localhost origins are allowed automatically).
CORS_ORIGIN=https://admin.tinitraker.in,https://app.tinitraker.in

# ── Reverse Proxy Trust ───────────────────────────────────────────────────────
# Set to true ONLY when the app is behind a trusted reverse proxy (Nginx, ALB,
# Cloudflare, Vercel) that strips/overwrites client-supplied forwarding headers.
# When false/unset, cf-connecting-ip / x-forwarded-for / x-real-ip are ignored
# and the socket IP is used, preventing rate-limit bypass via spoofed headers.
TRUST_PROXY=false

# ── One-time Setup Endpoint (/api/setup/init) ────────────────────────────────
# Required in production. The first-run setup request must send this value in
# the X-Setup-Token header (or a `setup_token` JSON field). If omitted in
# production the endpoint refuses all requests. In development, setup is
# allowed without a token when this is unset.
SETUP_TOKEN=REPLACE_WITH_RANDOM_ONE_TIME_SETUP_TOKEN

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.tinitraker.in
NEXT_PUBLIC_APP_NAME=TiniTraker

# ── Provider Admin (Primary Account) ─────────────────────────────────────────
# Seeded automatically on first server boot if not already in the database.
PROVIDER_ADMIN_EMAIL=admin@tinitraker.in
PROVIDER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
PROVIDER_ADMIN_NAME=TiniTraker Superadmin
PROVIDER_ADMIN_ROLE=superadmin

# ── Provider Admin (Additional Accounts — Optional) ──────────────────────────
# Option 1: Numbered accounts (supports 1 to 50)
# PROVIDER_ADMIN_1_EMAIL=support@tinitraker.in
# PROVIDER_ADMIN_1_PASSWORD=YourPassword
# PROVIDER_ADMIN_1_ROLE=support
# PROVIDER_ADMIN_1_NAME=Support Account

# Option 2: Comma-separated (email:password:role:name)
# PROVIDER_ADMIN_USERS="ops@tinitraker.in:OpsPass@2026:superadmin:Ops Lead"

# ── WhatsApp API (Platform Fallback) ─────────────────────────────────────────
# Used when a hospital has no per-hospital WhatsApp config set.
WHATSAPP_API_URL=https://your-whatsapp-api-url/v2/send
WHATSAPP_API_KEY=your_whatsapp_api_key

# ── Email / SMTP (for OTP Verification) ──────────────────────────────────────
# Optional in development (OTPs logged to terminal if not set).
# Required in production for OTP email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TiniTraker" <noreply@tinitraker.in>
# TLS certificate validation is enforced by default. Only set this to true for
# hosts with genuinely self-signed certs (e.g. some cPanel shared hosting).
SMTP_ALLOW_SELF_SIGNED=false
